{
  "name": "react-fog",
  "version": "1.2.13",
  "type": "module",
  "description": "A component that adds a fog effect to indicate scrollability to overflowed components.",
  "author": "fe-dudu <ehehwhdwhd@naver.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fe-dudu/react-fog.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "react",
    "react-component",
    "fog-style",
    "fog-wrapper",
    "MUi",
    "material-ui",
    "MUi table effect",
    "MUi table style",
    "MUi table fog",
    "MUi chip effect",
    "MUi chip style",
    "MUi chip fog"
  ],
  "homepage": "https://github.com/fe-dudu/react-fog",
  "bugs": {
    "url": "https://github.com/fe-dudu/react-fog/issues"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "enter": "changeset pre enter rc",
    "exit": "changeset pre exit",
    "changeset": "changeset",
    "changeset:publish": "pnpm build && changeset publish",
    "changeset:version": "changeset version && pnpm i --lockfile-only",
    "changeset:publish-rc": "pnpm build && changeset publish --tag rc",
    "build": "tsc"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.11",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "typescript": "^5.4.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@9.12.3"
}
